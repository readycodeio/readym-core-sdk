<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Never packed itself. Named apart from the ReadyM.SDK.Server package that ships this assembly, whose
             project references this one: NuGet restore refuses two projects of the same name. -->
        <PackageId>ReadyM.SDK.Server.Assembly</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ReadyM.Relay.Server.Sdk\ReadyM.Relay.Server.Sdk.csproj"/>
        <ProjectReference Include="..\ReadyM.SDK\ReadyM.SDK.csproj"/>
        <ProjectReference Include="..\ReadyM.SDK.Chunks\ReadyM.SDK.Chunks.csproj"/>
        <ProjectReference Include="..\ReadyM.Api.Generators\ReadyM.Api.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
        <ProjectReference Include="..\ReadyM.Api.Multiplayer\ReadyM.Api.Multiplayer.csproj"/>
        <ProjectReference Include="..\ReadyM.Native\ReadyM.Native.csproj"/>
    </ItemGroup>

</Project>
