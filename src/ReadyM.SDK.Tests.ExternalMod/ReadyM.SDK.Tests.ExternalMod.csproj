<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- netstandard2.0 like a mod's shared Common project, so the net10 SDK it runs against is not
             the build it compiled against. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Deliberately no InternalsVisibleTo from the SDK: this stands in for a mod assembly, so it
         reaches declarations only through what the generators emit as public. -->
    <ItemGroup>
        <ProjectReference Include="..\ReadyM.SDK\ReadyM.SDK.csproj"/>
        <ProjectReference Include="..\ReadyM.Api.Generators\ReadyM.Api.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
    </ItemGroup>

</Project>
