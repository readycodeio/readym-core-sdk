<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Friflo.Engine.ECS\src\ECS\Friflo.Engine.ECS.csproj"/>
        <ProjectReference Include="..\ReadyM.Api\ReadyM.Api.csproj"/>
        <ProjectReference Include="..\ReadyM.Api.Multiplayer\ReadyM.Api.Multiplayer.csproj"/>
        <ProjectReference Include="..\ReadyM.Api.Generators\ReadyM.Api.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
    </ItemGroup>

    <!-- The chunk fast path needs ref fields, allows ref struct and static abstract interface
         members, none of which netstandard2.0 has. An ns2.0 build leaves it out, and the generator
         emits no view against that build because it cannot see these types. -->
    <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
        <Compile Remove="Chunks\**"/>
    </ItemGroup>

</Project>
