<?xml version="1.0" encoding="utf-8"?>

<Project>
    <PropertyGroup>
        <!-- Number of days since Dec 17, 2024 -->
        <BuildValue>$([System.DateTime]::op_Subtraction($([System.DateTime]::UtcNow), $([System.DateTime]::Parse('2024-12-17'))).Days)</BuildValue>
        <!-- Hours and minutes as a four-digit number -->
        <RevisionValue>$([System.DateTime]::UtcNow.ToString('HHmm'))</RevisionValue>
        <BuildTimestamp>$(BuildValue).$(RevisionValue)</BuildTimestamp>
        <FileVersion>1.0.$(BuildTimestamp)</FileVersion>
        <Version>1.0.$(BuildTimestamp)</Version>
        <InformationalVersion>1.0.$(BuildTimestamp)</InformationalVersion>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- silence CS1591 warning for missing XML comments -->
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'NoDisconnect'">
        <DefineConstants>$(DefineConstants);DEBUG;NO_DISCONNECT;SELF_HOSTED</DefineConstants>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <OutputPath>bin\NoDisconnect\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <IntermediateOutputPath>obj\NoDisconnect\</IntermediateOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Testing'">
        <DefineConstants>$(DefineConstants);DEBUG;TESTING</DefineConstants>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <OutputPath>bin\Testing\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <IntermediateOutputPath>obj\Testing\</IntermediateOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DefineConstants>$(DefineConstants);SELF_HOSTED</DefineConstants>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>
    <PropertyGroup Condition="'$(SelfHosted)' == 'true'">
        <DefineConstants>$(DefineConstants);SELF_HOSTED</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'DebugSelfHosted'">
        <DefineConstants>$(DefineConstants);DEBUG;SELF_HOSTED</DefineConstants>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <OutputPath>bin\DebugSelfHosted\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <IntermediateOutputPath>obj\DebugSelfHosted\</IntermediateOutputPath>
    </PropertyGroup>
</Project>