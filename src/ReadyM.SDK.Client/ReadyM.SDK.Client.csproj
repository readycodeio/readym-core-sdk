<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Never packed itself. Named apart from the ReadyM.SDK.Client package that ships this assembly, whose
             project references this one: NuGet restore refuses two projects of the same name. -->
        <PackageId>ReadyM.SDK.Client.Assembly</PackageId>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\ReadyM.SDK\ReadyM.SDK.csproj" />
      <ProjectReference Include="..\ReadyM.Api\ReadyM.Api.csproj" />
      <ProjectReference Include="..\ReadyM.Api.Generators\ReadyM.Api.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    </ItemGroup>

    <!-- The relay client, in Relay/ -->
    <ItemGroup>
        <PackageReference Include="LiteNetLib" Version="1.3.5" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
        <PackageReference Include="Nito.AsyncEx" Version="5.1.2" />
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
        <PackageReference Include="System.Text.Encodings.Web" Version="10.0.8" />
        <PackageReference Include="System.Text.Json" Version="10.0.8" />
    </ItemGroup>

    <!-- The chunk fast path needs ref fields, allows ref struct and static abstract interface
         members, none of which netstandard2.0 has. An ns2.0 client keeps the identity path, and the
         generator emits no view for it because it cannot see these types. -->
    <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
        <Compile Remove="Chunks\**"/>
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>

</Project>
